# Copy to .env (never commit it) or set these in your shell for anything beyond a local demo.
# Without them, AgentShield uses dev keys like "dev-key-coordinator" and prints nothing secret.
AGENTSHIELD_GATEWAY_TOKEN=change-me
AGENTSHIELD_KEY_COORDINATOR=change-me
AGENTSHIELD_KEY_INVOICE_READER=change-me
AGENTSHIELD_KEY_POLICY_CHECKER=change-me
AGENTSHIELD_KEY_PAYMENT_APPROVER=change-me
